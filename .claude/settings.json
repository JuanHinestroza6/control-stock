{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(gh run *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v *)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["repo.maven.apache.org"]
    }
  }
}
