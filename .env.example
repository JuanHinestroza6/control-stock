# Copiar a .env (no se versiona) y reemplazar TODOS los valores de ejemplo.
# Lo leen: docker compose (raiz) y el backend (spring.config.import optional:file:../.env[.properties]).
# Sin comillas ni espacios alrededor del "=" (formato valido para docker compose y .properties).

# --- Base de datos (MySQL 8.4) ---
DB_NAME=control_stock
DB_USER=control_stock
DB_PASSWORD=cambiar-password-db
DB_ROOT_PASSWORD=cambiar-password-root
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/control_stock

# --- JWT (HS256) ---
# OBLIGATORIO. Debe tener AL MENOS 32 bytes (32 caracteres ASCII) o la app no arranca; no puede empezar por "cambiar".
# Generar uno: openssl rand -base64 48
JWT_SECRET=
# Duracion del token (Duration de Spring: 8h, 30m, ...)
JWT_EXPIRACION=8h

# --- ADMIN inicial: V2 de Flyway lo crea solo si no existe ningun ADMIN (si ya existe, pueden quedar vacios) ---
ADMIN_EMAIL=admin@ejemplo.com
# Minimo 12 caracteres (obligatorio solo si aun no existe un ADMIN); no puede empezar por "cambiar".
ADMIN_PASSWORD=

# --- CORS: origenes permitidos, separados por coma ---
CORS_ORIGENES=http://localhost:5173

# --- Perfil de Spring (opcional): dev | dev,seed ---
# OJO: aquí NO activa perfiles (este archivo se importa como propiedades). Defínelo como variable de entorno real
# o pasa -Dspring-boot.run.profiles=dev a Maven.
# SPRING_PROFILES_ACTIVE=dev
